# Copie este arquivo para ".env" antes de rodar `docker compose up --build`.
# Valores só para desenvolvimento local.

# PostgreSQL
DB_NAME=mdb
DB_USER=mdb
DB_PASSWORD=mdb
DB_PORT=5432

# API Java
JAVA_PORT=8080
JWT_SECRET=development-only-secret-key-change-me-please-1234567890
JWT_EXPIRATION_MINUTES=1440

# API Python
PYTHON_PORT=8000

# Front-end (nginx)
FRONTEND_PORT=8081

# CORS (origens permitidas nos dois backends), separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5500,http://localhost:3000
